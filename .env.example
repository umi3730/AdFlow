ADFLOW_ENV=local
ADFLOW_DEMO_DATA=true
ADFLOW_HTTP_ADDR=:18080
ADFLOW_SHUTDOWN_TIMEOUT=10s
ADFLOW_DEPENDENCY_TIMEOUT=800ms
ADFLOW_MYSQL_DSN=adflow:adflow@tcp(127.0.0.1:3306)/adflow?parseTime=true&charset=utf8mb4&loc=Local
ADFLOW_REDIS_ADDR=127.0.0.1:6379
ADFLOW_REDIS_PASSWORD=
ADFLOW_REDIS_DB=0
ADFLOW_CAMPAIGN_REPOSITORY=memory
ADFLOW_RESERVATION_ADAPTER=memory
ADFLOW_DECISION_STORE=memory
ADFLOW_PROFILE_STORE=memory
ADFLOW_EVENT_TRANSPORT=sync
ADFLOW_KAFKA_BROKERS=127.0.0.1:9092
ADFLOW_KAFKA_TOPIC=adflow.ad-events.v1
ADFLOW_KAFKA_DEAD_LETTER_TOPIC=adflow.ad-events.dlq.v1
ADFLOW_KAFKA_CONSUMER_GROUP=adflow-metrics-v1
ADFLOW_AUTH_ENABLED=false
# Demo registrations receive admin permissions. Defaults on in local/test.
ADFLOW_REGISTRATION_ENABLED=true
# ADFLOW_AUTH_STORE=mysql
ADFLOW_JWT_SECRET=adflow-local-development-secret-change-me
ADFLOW_JWT_ISSUER=adflow
ADFLOW_ACCESS_TOKEN_TTL=30m
ADFLOW_AUTH_USERS=
ADFLOW_AUDIT_STORE=memory
ADFLOW_DECISION_RATE_LIMIT=5000
ADFLOW_DECISION_RATE_LIMITER=memory
ADFLOW_DECISION_RATE_WINDOW=1s
ADFLOW_DECISION_BURST=1000
ADFLOW_DECISION_MAX_IN_FLIGHT=256
ADFLOW_DECISION_QUEUE_TIMEOUT=5ms
ADFLOW_DECISION_TIMEOUT=100ms
ADFLOW_ASYNC_BACKPRESSURE=true
ADFLOW_SETTLEMENT_BACKLOG_HIGH=100
ADFLOW_SETTLEMENT_BACKLOG_LOW=40
ADFLOW_OUTBOX_BACKLOG_HIGH=600
ADFLOW_OUTBOX_BACKLOG_LOW=240
ADFLOW_AGENT_PROVIDER=mock
ADFLOW_AGENT_BASE_URL=https://api.openai.com/v1
ADFLOW_AGENT_API_KEY=
ADFLOW_AGENT_MODEL=
ADFLOW_AGENT_API_STYLE=responses
ADFLOW_AGENT_TIMEOUT=8s
ADFLOW_AGENT_MAX_RETRIES=2
ADFLOW_AGENT_FALLBACK_ENABLED=true
ADFLOW_AGENT_CIRCUIT_FAILURES=3
ADFLOW_AGENT_CIRCUIT_OPEN=30s
ADFLOW_AGENT_MAX_DAILY_BUDGET_FEN=10000000
ADFLOW_AGENT_MAX_IMPRESSION_COST_FEN=100000
ADFLOW_AGENT_MAX_CONDITIONS=20
